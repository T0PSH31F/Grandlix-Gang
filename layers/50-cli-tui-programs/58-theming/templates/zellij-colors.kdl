// Matugen template for Zellij terminal multiplexer
// Material You color scheme generated from wallpaper

themes {
    matugen {
        fg "{{colors.on_surface.default.hex}}"
        bg "{{colors.surface.default.hex}}"

        black "{{colors.surface_dim.default.hex}}"
        red "{{colors.error.default.hex}}"
        green "{{colors.primary.default.hex}}"
        yellow "{{colors.tertiary.default.hex}}"
        blue "{{colors.primary_container.default.hex}}"
        magenta "{{colors.tertiary_container.default.hex}}"
        cyan "{{colors.secondary_container.default.hex}}"
        white "{{colors.on_surface_variant.default.hex}}"

        orange "{{colors.tertiary.default.hex}}"

        // ── UI Frame & Border Colors ──────────────────────────────
        // Active pane border uses a brighter accent for glow effect
        frame_border_active "{{colors.primary.default.hex}}"
        // Inactive pane border is subtle
        frame_border_inactive "{{colors.surface_container.default.hex}}"
        // Status/tab bar backgrounds
        tab_bar_bg "{{colors.surface_container_high.default.hex}}"
        status_bar_bg "{{colors.surface_container_high.default.hex}}"
        // Selection highlight
        selection_bg "{{colors.primary.default.hex}}"
        selection_fg "{{colors.on_primary.default.hex}}"
    }
}

// UI theme configuration
theme "matugen"
