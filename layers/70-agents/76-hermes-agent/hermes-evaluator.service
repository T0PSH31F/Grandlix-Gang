[Unit]
Description=Hermes Evaluator — Daily Audit & Benchmarking
After=network.target langfuse.service

[Service]
Type=oneshot
User=t0psh31f
Environment=HOME=/home/t0psh31f
WorkingDirectory=/home/t0psh31f/.hermes/evaluator
ExecStart=/run/current-system/sw/bin/python3 /home/t0psh31f/.hermes/evaluator/scripts/hermes-evaluator.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600
Nice=19
IOSchedulingClass=idle
