## Implementation: Inventory with Tags

**flake.nix** :
```nix
{
  description = "Erik's NixOS Fleet with Clan-Core";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    clan-core.url = "git+https://git.clan.lol/clan/clan-core";
    home-manager.url = "github:nix-community/home-manager";
  };

  outputs = { self, nixpkgs, clan-core, home-manager, ... }:
  let
    # Define clan with inventory
    clan = clan-core.lib.buildClan {
      # Machine inventory with tags
      inventory = {
        # Define all machines with their tags
        machines = {
          "framework-laptop" = {
            tags = [ "workstation" "laptop" "backup" "ai" ];
            deploy.targetHost = "framework.tail-net.ts.net";
          };
          
          "homelab-server" = {
            tags = [ "server" "backup-server" "monitoring-server" "ai" ];
            deploy.targetHost = "homelab.tail-net.ts.net";
          };
          
          "nas" = {
            tags = [ "server" "backup-server" "storage" ];
            deploy.targetHost = "nas.tail-net.ts.net";
          };
          
          "workstation" = {
            tags = [ "workstation" "development" "ai" ];
            deploy.targetHost = "workstation.tail-net.ts.net";
          };
        };

        # Service instances targeting tags
        instances = {
          # Backup service: all tagged "backup" are clients
          borgbackup = {
            module = {
              name = "borgbackup";
              input = "clan-core";
            };
            roles = {
              client.tags = [ "backup" ];              # All machines with "backup" tag
              server.machines."homelab-server" = {};   # Specific machine as server
            };
          };

          # Monitoring: all servers report metrics
          prometheus = {
            module = {
              name = "prometheus";
              input = "clan-core";
            };
            roles = {
              server.machines."homelab-server" = {};
              target.tags = [ "server" "workstation" ]; # Monitor these tags
            };
          };

          # ZeroTier VPN mesh
          zerotier = {
            module = {
              name = "zerotier-controller";
              input = "clan-core";
            };
            roles = {
              controller.machines."homelab-server" = {};
              peer.tags = [ "server" "workstation" "laptop" ]; # All join VPN
            };
          };
        };
      };

      # Directory containing machine configs
      directory = self;
      
      # Path to machine-specific configs
      machines = ./machines;
      
      # Special arguments passed to modules
      specialArgs = { inherit home-manager; };
    };
  in {
    # Expose clan outputs
    inherit (clan) nixosConfigurations clanInternals;
    
    # Make inventory accessible
    inventory = clan.clanInternals.inventory;
  };
}
