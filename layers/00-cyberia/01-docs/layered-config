  imports = [
    ../../layers/00-foundation
    ../../layers/10-system/containers/docker.nix
    ../../layers/10-system/filesystems/zfs.nix
    ../../layers/20-services/web/nginx.nix
  ];

  # Server-specific config
  config = {
    # Headless server
    boot.kernelParams = [ "quiet" ];
    
