Automatic Tag-Based Configuration
Create a helper that automatically imports profiles based on machine tags:

lib/mkMachineFromTags.nix:

text
{ lib, clan-core, ... }:

{ machineName, inventory }:
let
  machineConfig = inventory.machines.${machineName};
  tags = machineConfig.tags or [];
  
  # Map tags to profile paths
  tagToProfile = tag: 
    if builtins.pathExists ../profiles/tags/${tag}.nix
    then [ ../profiles/tags/${tag}.nix ]
    else [];
  
  # Collect all profiles from tags
  profileImports = lib.flatten (map tagToProfile tags);
  
in {
  imports = profileImports ++ [
    ./machines/${machineName}
  ];
  
  # Make tags accessible in config
  _module.args.machineTags = tags;
}
Usage in flake.nix:

text
let
  mkMachine = machineName: lib.nixosSystem {
    system = "x86_64-linux";
    specialArgs = { inherit clan-core inventory; };
    modules = [
      (import ./lib/mkMachineFromTags.nix {
        inherit lib clan-core;
      } { inherit machineName inventory; })
    ];
