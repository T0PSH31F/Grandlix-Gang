Layered Services with Clan Roles
clan/services/borgbackup.nix:

text
{ config, lib, pkgs, ... }: {
  # This gets automatically applied to machines based on inventory roles
  
  # Client role (applied to machines with "backup" tag)
  clan.core.services.borgbackup.client = {
    enable = true;
    # Include specific layers in backup
    paths = [
      "/home"
      "/etc/nixos"
      "/var/lib/docker"
    ];
    exclude = [
      "*.cache"
      "*/node_modules"
    ];
  };
  
  # Server role (applied to backup-server machines)
  clan.core.services.borgbackup.server = {
    enable = true;
    storage = "/backup/borg";
  };
}
Layer-Aware Clan Service
layers/20-services/monitoring/prometheus.nix:

text
{ config, lib, pkgs, machineTags ? [], ... }: {
  # Service layer that's clan-aware
  
  options.layers.monitoring = {
    enable = lib.mkEnableOption "monitoring layer";
    exporters = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [];
      description = "Which prometheus exporters to enable";
    };
  };

  config = lib.mkIf config.layers.monitoring.enable {
    # Always enable node exporter
    services.prometheus.exporters.node = {
      enable = true;
      enabledCollectors = [ "systemd" ];
    };
    
    # Enable docker exporter if docker is in a layer
    services.prometheus.exporters.docker = lib.mkIf config.virtualisation.docker.enable {
      enable = true;
    };
    
    # Enable postgres exporter if postgres is in a layer
    services.prometheus.exporters.postgres = lib.mkIf config.services.postgresql.enable {
      enable = true;
    };
    
    # Tag-specific exporters
    services.prometheus.exporters.nginx = lib.mkIf (builtins.elem "server" machineTags) {
      enable = config.services.nginx.enable;
    };
  };
}
